    <!--
        displaypatten 字段含义，展示模式 0 传统展示方案，展示文件名，路径，大小
                                展示模式 1 图片，视频或其它有封面的文件展示方案，展示封面信息
                                展示模式 2 视频展示方案，例如视频，动态图

        sort 字段含义， 排序type 0 传统按照大小进行排序
                        排序type 1 按照时间进行排序
                        排序type 2 主排序按照时间进行，内部排序按照大小进行
        特别注意
                        id，cid在硬盘管理大师的产品里面，可能会被用作界面点击情况收集，非必要不要修改，如果新增分类必须在原id最大值进行增加，避免数据异常
    -->
    
    <softlist>
    
        <soft id="70005042" name="微信">
            <category cid="102" name="聊天视频" show="3"><!--一级分类-->
                <subcategory id="1021" displaypatten="2" name="聊天视频" deletefolder="1" open="1"><!--二级分类-->
                    <rules>
                        <rule id="1008" selected="1" />
                    </rules>
                    <sort type="1">
                        <virlimit id="1" selected="0" show="3"/><!--如果配置有name="xxx"，是三级分类-->
                        <!--
                        重要tips：category也可以配置show，用法和下面内容一样，如果category配置show代表整个一级分类按照show的意思进行处理，sort配置的show无效
                        
                        show="1"代表二级分类和三级分类合并,，展示在二级分类上面，使用()展示三级分类内容，
                        show="0"代表二级分类和三级分类合并,，展示在二级分类上面，并且三级分类的名称不显示，
                        
                        20230206，根据产品需求，以下字段值属于新增
                        show="2"代表二级分类和三级分类取消展示，检出内容在一级分类展示，一级分类下面，如果有show=2，只能只有subcategory下面的subcategory只有一个，多个则属于非法配置
                        
                        virlimit节点和limit互斥关系，里面只有id="1" selected="0" show="3"这三个字段，专门用于虚拟分组场景
                        show = 3,4只适用virlimit里面
                        show="3"代表二级分类和三级分类取消展示，检出的内容，根据文件修改时间获取xx年xx月，拼接二级分类的name，形成虚拟的二级分类展示，比如文件创建时间2023年1月，则显示虚拟二级分类为2023年01月聊天视频
                        show="4"代表二级分类和三级分类取消展示，检出的内容，根据文件修改时间获取xx年xx季度，拼接二级分类的name，形成虚拟的二级分类展示，比如文件创建时间2023年1季度，则显示虚拟二级分类为2023年01季度聊天视频
                        
                        -->
                    </sort>
                </subcategory>
            </category>
